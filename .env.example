# Required only for LLM-powered orchestration. Deterministic analytics/RAG still work without it.
OPENAI_API_KEY=
PRICING_LLM_MODEL=gpt-5.6-terra

# Optional OpenAI embeddings. Leave empty to use the deterministic local hashing embedder.
PRICING_EMBEDDING_MODEL=

# RAG/vector-store configuration. Without QDRANT_URL the local JSON store is used.
PRICING_VECTOR_STORE=data/vector_store/evidence.json
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=pricing_evidence

# Agent harness limits
PRICING_AGENT_TRACING=true
PRICING_AGENT_MAX_STEPS=12
PRICING_AGENT_MAX_REVISIONS=1
PRICING_TOOL_TIMEOUT_SECONDS=20
PRICING_RAG_TOP_K=6

# Optional trusted external Streamable HTTP MCP servers, comma-separated.
# The bridge requires approval for every external MCP tool call.
PRICING_EXTERNAL_MCP_URLS=
